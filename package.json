{
  "name": "probe-web",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "description": "Probe \u2014 a voice examination on the document you have to defend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && node deploy/publish.mjs",
    "build:trial": "tsc --noEmit && vitest run && vite build --mode trial",
    "dev:trial": "vite --mode trial",
    "deploy:trial": "npm run build:trial && node deploy/publish.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.0"
  }
}
